@bot.message_handler(commands=['addvip'])
def add_vip(message):
    if message.from_user.id != OWNER_ID:
        bot.reply_to(message, "🚫 Only the owner can use this command!")
        return

    args = message.text.split()
    if len(args) != 2 or not args[1].isdigit():
        bot.reply_to(message, "❌ Use: `/addvip <user_id>`", parse_mode="Markdown")
        return

    vip_id = int(args[1])
    VIP_USERS.add(vip_id)
    bot.reply_to(message, f"✅ User `{vip_id}` added to VIP list!", parse_mode="Markdown")

